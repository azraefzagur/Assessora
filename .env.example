NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgres://assessora:change-me-local@127.0.0.1:5432/assessora
POSTGRES_USER=assessora
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=assessora
# Gerçek HTTPS proxy dağıtımında true ayarlanır.
TRUST_PROXY=false
# Davet bağlantıları için kalıcı rastgele gizli anahtar. Örnek değeri kullanmayın.
INVITATION_SIGNING_KEY=replace-with-a-random-32-character-or-longer-secret
# disabled: gönderim kapalı; test: yalnız development, gerçek e-posta yok; smtp: gerçek SMTP.
MAIL_MODE=disabled
# Kod üretme/doğrulama için kalıcı gizli anahtar. En az 32 karakter; .env dışında paylaşmayın.
CODE_SIGNING_KEY=replace-with-a-random-32-character-or-longer-secret
# Davet bağlantısının taban adresi. Gerçek SMTP davetinde dışarıdan erişilebilir HTTPS olmalı.
APP_PUBLIC_URL=http://127.0.0.1:5173
# SMTP modunda doğrulanmış gönderici adresi ve servisinizin bağlantı bilgileri gerekir.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
